[ardent_sect]
activate = 1
# .include ardent.so.mac

############################################################################################
############################################################################################
# Configuration subsections

# Logging sinks/outputs
logging = logging_sect

# Sources for seed entropy
seed = seed_sect

# Local IPC control endpoint (see DEBUGGING.md for full information).  
debug-ipc-path = /home/dev/INTEROP_DEMO/interop.file

############################################################################################
############################################################################################
# DETAIL: LOGGING
# OPTIONAL -- Error handling is performed via OpenSSL

[logging_sect]
syslog = syslog_sect
stderr = stderr_sect
extlog = extlog_sect

# Log all FIPS indicators to activate sinks
fips-indicators = 1

# Before the logging subsystem is active, if you want log messages, 
# set this to [stderr|syslog]
#prestart=syslog
prestart=stderr

[syslog_sect]
activate=0
level=INFO

[stderr_sect]
activate=0
level=INFO

[extlog_sect]
activate=0
level=INFO
filepath = /abs/path/to/libextlogging.so
functions = sink_example

############################################################################################
############################################################################################
# Seed Configuration
#
# The sections below identify and configure one or more seed sources.  There are 5 types of
# seed sources: jitter, rdseed, rdrand, osrand, and external.  Each type is described in more
# detail below.  For the first three sources, there is one and only one instance per machine.  
# For the later two, there can be up to 4 distinct instances per type per machine.
#
# All configuration options for each seed source are provided in the sections below.  A 
# seed source must specify that it is to be activated (activate=1) in this section.  In 
# addition, each seed source must specify the native block size, and the number of blocks
# that must be gathered to guarantee 256 bits of credited entropy.  The built-in jitter
# entropy source is credited with full entropy, and has a block size of 256-bits, so these 
# values are (256/1).  A low-quality hardware source might have 128-bit block sizes and 
# require 96 blocks (128/96, or 12288 bits total) to guarantee 256 credited bits.
#
# Each source may specify that it is a "hardware source" for purposes of entropy source
# counting.  This value is assumed to be "0" (non-hardware) unless explicitly set to "1".
# This information is only applicable when the "restrictive entropy counting" is also 
# specified.  See additional comments below for aadditional detail.
#
# Within the configuration, at least one source must be identified as a "validated" source,
# meaning the source has undergone some validation process, such as Entropy Source Validation 
# (ESV).  The unique validation identifier (e.g. "E239") must be indicated on the appropriate
# configuration option, and is displayed to users when requested.  Validated sources are used 
# internally for "entropy" and "nonce" purposes, which require high security strength.
#
# There may be additional seed sources that are not validated.  These seed sources will be
# used for "additional input", which is not required meet the same high security strength 
# standards.
# 
# In total, no more than 8 validated and 8 non-validated sources may be activated.

[seed_sect]
jitter = jitter_sect
rdseed = rdseed_sect
rdrand = rdrand_sect
osrand = osrand_sect
extseed = extseed_sect

# A "Personalization String" used to initialize the seed source.  This value should be 
# unique for each device. This value is stored in an adjacent file and inlined at runtime
#.include personalization.cnf

# Use the more restricted method of counting validated entropy sources, which 
# has the effect of requiring at least one (1) hardware source backing all
# entropy usage (notably, activated at startup and providing material for each gather).
#restricted-entropy-counting = 1

# ARDENT can use either a synchronous or asychronous mode.  In asynchronous mode, a seed
# request is services immedately from a ring buffer, and background worker threads, 
# one per seed source, refill the ring buffer.  
# If this option is zero (0) or missing, ARDENT will operate in synchronous mode with a 
# single thread and will block while gathering entropy.
async-mode = 0

# ARDENT will always ask the seeds sources for entropy upon receiving an 
# entropy request from OpenSSL. ARDENT can use the following set of policies to determine 
# the behavior around (temporrily) failed seed sources.
#
# The "all" and "some" settings are mutually exclusive (both cannot be "1").
# If both are zero, the DRBG will continue to service entropy requests if
# no sources provide entropy.  It will do this until a maximum of 2^17 bits
# have been returned.  Any valid entropy from a source resets this counter.

# Require all sources to provide entropy for each request
# Default: 0 (only 1 validated source is needed)
req-all-sources = 0

# Operate as RBG2 or RBG3
# Valid values: "RBG2" or "RBG3"
# Default:
#rbg-entropy-mode=RBG3
rbg-entropy-mode=RBG2

# Require at least one of the sources to be a hardware source.
# Corresponds to SP800-90 restrictive entropy counting "Method 1"
# Default: 0
req-hardware-source = 0

############################################################################################
# JITTER ENTROPY seed source
# Jitterentropy is statically linked into the provider from an externally supplied archive.
# It must comply with all technical/compilation requirements a valid ESV Certificate. The
# operational environment must be listed on the certificate (or a rebranded certificate) 
# for this source to be considered ESV-compliant. 

[jitter_sect]
activate = 0
validated = "Exxx"

block-size = 256
block-count = 1

# Value set by ESV
oversample-rate = 4

############################################################################################
# RDSEED seed source
# This source provides access to CPU-based seed sources from Intel and AMD.  Status of ESV 
# compliance is highly dependent on CPU and environmental considerations.  

[rdseed_sect]
activate = 1
validated = "Exxx"
hardware-source=1

# Intel RDSEED
block-size = 128
block-count = 2

# AMD RDSEED
#block-size = 128
#block-count = 192

############################################################################################
# RDRAND seed source
# This source provides access to CPU-based seed sources from Intel and AMD.  The seed source
# can never be marked as "validated", due to the design of the hardware source.

[rdrand_sect]
activate = 0

# Intel RDRAND
#block-size = 128
#block-count = 2

# AMD RDRAND
block-size = 128
block-count = 192

############################################################################################
# OSRAND seed source
# This is as source that reads entropy directly from a file source on a Linux-ish system.
# The most commonly used source will be "/dev/random", but this source is equally suitable
# for any source that provides entropy through this common interface (e.g. /dev/hwrand).
#
# Up to four (4) distinct OSRand sources can be specified.  The configuration options for
# each source must be prepended with the number (1..4).  Examples below can be altered
# as needed.
#
# In addition to the standard options, one additional configuration option isrequired by the 
#  provider:
# filepath = absolute path to the shared object

[osrand_sect]

# Linux Kernel x.y.z
1.activate = 1
1.validated = "FOR EVAL"
1.block-size = 256
1.block-count = 1
1.filepath = /dev/random

# HWRAND source
2.activate = 0
2.block-size = 64
2.block-count = 8
2.filepath = /dev/hw_rng
2.hardware-source=1

############################################################################################
# EXTERNAL seed source
# An external entropy source loaded from a shared object (.so/.dll) at startup.  The 
# configuration below are the minimum required to describe the entropy capabilities.
# Additonal options can be stored here and retrieved by the methods demonstrated in the 
# example external seed source (see examples directory).
#
# Up to four (4) distinct external sources can be specified.  The configuration options for
# each source must be prepended with the number (1..4).  Example below can be altered
# as needed.
#
# In addition to the standard options, there are two configuration options are required by the 
# provider:
# filepath = absolute path to the shared object
# functions = name of the symbol used for the "const STUB_FUNCTIONS <name>" array of pointers

[extseed_sect]

# ARDent JEnt example
1.activate = 0
1.block-size = 256
1.block-count = 1
1.filepath = /abs/path/to/libextjitter.so
1.functions = stub_example
